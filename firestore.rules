rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions & Zero-Trust Security Guards
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isDocSizeValid(maxFields) {
      return request.resource.data.size() <= maxFields;
    }

    // -------------------------------------------------------------
    // System Connection Probe (Read-Only Single Doc)
    // -------------------------------------------------------------
    match /system/connection_probe {
      allow get: if true;
      allow list, write: if false;
    }

    // -------------------------------------------------------------
    // User Profiles & Roles (Strict PII Owner Isolation)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().id == userId
                    && incoming().uid == userId
                    && incoming().email is string
                    && incoming().email.size() <= 254
                    && incoming().role in ['developer', 'operator']
                    && isDocSizeValid(15);
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().id == existing().id
                    && incoming().uid == existing().uid
                    && incoming().role == existing().role
                    && incoming().created_at == existing().created_at
                    && isDocSizeValid(15);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Multi-Tenant Workspaces
    // -------------------------------------------------------------
    match /workspaces/{workspaceId} {
      allow get: if isAuthenticated() && (existing().owner_uid == request.auth.uid || (existing().members is list && existing().members.hasAny([request.auth.uid])));
      allow list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(workspaceId)
                    && incoming().workspace_id == workspaceId
                    && incoming().owner_uid == request.auth.uid
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 120
                    && isDocSizeValid(15);
      allow update: if isAuthenticated()
                    && isValidId(workspaceId)
                    && existing().owner_uid == request.auth.uid
                    && incoming().owner_uid == existing().owner_uid
                    && incoming().workspace_id == existing().workspace_id
                    && isDocSizeValid(15);
      allow delete: if isAuthenticated() && isValidId(workspaceId) && existing().owner_uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Projects (Scoped Strictly to Owner UID)
    // -------------------------------------------------------------
    match /projects/{projectId} {
      allow get, list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(projectId)
                    && incoming().project_id == projectId
                    && incoming().owner_uid == request.auth.uid
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 100
                    && isDocSizeValid(20);
      allow update: if isAuthenticated()
                    && isValidId(projectId)
                    && existing().owner_uid == request.auth.uid
                    && incoming().owner_uid == existing().owner_uid
                    && incoming().project_id == existing().project_id
                    && incoming().created_at == existing().created_at
                    && isDocSizeValid(20);
      allow delete: if isAuthenticated() && isValidId(projectId) && existing().owner_uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // AI Agents Registry (Scoped Strictly to Owner UID)
    // -------------------------------------------------------------
    match /agents/{agentId} {
      allow get, list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(agentId)
                    && incoming().agent_id == agentId
                    && incoming().owner_uid == request.auth.uid
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 120
                    && incoming().target_capability is string
                    && incoming().target_capability.size() <= 120
                    && isDocSizeValid(25);
      allow update: if isAuthenticated()
                    && isValidId(agentId)
                    && existing().owner_uid == request.auth.uid
                    && incoming().owner_uid == existing().owner_uid
                    && incoming().agent_id == existing().agent_id
                    && incoming().created_at == existing().created_at
                    && isDocSizeValid(25);
      allow delete: if isAuthenticated() && isValidId(agentId) && existing().owner_uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Facts & Cryptographic Evidence (Owner Isolated)
    // -------------------------------------------------------------
    match /facts/{factId} {
      allow get, list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(factId)
                    && incoming().owner_uid == request.auth.uid
                    && incoming().entity_id is string
                    && incoming().entity_id.size() <= 128
                    && incoming().field_name is string
                    && incoming().field_name.size() <= 128
                    && isDocSizeValid(20);
      allow update: if isAuthenticated()
                    && isValidId(factId)
                    && existing().owner_uid == request.auth.uid
                    && incoming().owner_uid == existing().owner_uid
                    && isDocSizeValid(20);
      allow delete: if isAuthenticated() && isValidId(factId) && existing().owner_uid == request.auth.uid;
    }

    match /evidence/{evidenceId} {
      allow get, list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(evidenceId)
                    && incoming().owner_uid == request.auth.uid
                    && incoming().evidence_id == evidenceId
                    && incoming().payload_hash is string
                    && incoming().payload_hash.size() <= 128
                    && isDocSizeValid(20);
      allow update, delete: if false; // Evidence is immutable once observed
    }

    // -------------------------------------------------------------
    // Decision Receipts (Exact-ID Verifiable, Owner-Scoped List)
    // -------------------------------------------------------------
    match /receipts/{receiptId} {
      allow get: if isValidId(receiptId);
      allow list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(receiptId)
                    && incoming().owner_uid == request.auth.uid
                    && incoming().receipt_id == receiptId
                    && incoming().verdict != null
                    && isDocSizeValid(35);
      allow update, delete: if false; // Decision receipts are immutable
    }

    // -------------------------------------------------------------
    // Audit Ledger (Strict Append-Only Immutable Chain, Owner-Scoped)
    // -------------------------------------------------------------
    match /audit_events/{eventId} {
      allow get, list: if isAuthenticated() && existing().owner_uid == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidId(eventId)
                    && incoming().owner_uid == request.auth.uid
                    && incoming().audit_id == eventId
                    && incoming().action_hash is string
                    && incoming().action_hash.size() <= 128
                    && incoming().previous_hash is string
                    && incoming().previous_hash.size() <= 128
                    && isDocSizeValid(25);
      allow update, delete: if false; // Immutable tamper-evident audit ledger
    }

    // -------------------------------------------------------------
    // Default Deny Catchall
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
